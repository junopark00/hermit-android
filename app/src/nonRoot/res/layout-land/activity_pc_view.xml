<?xml version="1.0" encoding="utf-8"?>
<!-- Hermit: PC list screen (overrides upstream activity_pc_view). A top bar with the title and
     icon actions, and the "searching" state stacked in the centre, so it reads well in portrait
     as well as landscape. View ids are the ones PcView uses. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hermit_background"
    tools:context="com.junopark.hermit.PcView">

    <LinearLayout
        android:id="@+id/hermitPcTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_label"
            android:textColor="@color/hermit_text_primary"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/helpButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/hermit_action_help"
            android:padding="12dp"
            android:preferKeepClear="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_help"
            android:tint="@color/hermit_text_primary" />

        <ImageButton
            android:id="@+id/settingsButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/hermit_action_settings"
            android:padding="12dp"
            android:preferKeepClear="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            android:tint="@color/hermit_text_primary" />

        <ImageButton
            android:id="@+id/manuallyAddPc"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/hermit_action_add_pc"
            android:padding="12dp"
            android:preferKeepClear="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_add"
            android:tint="@color/hermit_text_primary" />
    </LinearLayout>

    <View
        android:id="@+id/hermitPcTopBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/hermitPcTopBar"
        android:background="@color/hermit_layer2" />

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/hermitPcTopBarDivider"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:maxWidth="360dp"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/hermit_pc_searching_title"
                android:textColor="@color/hermit_text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/hermit_pc_searching_hint"
                android:textColor="@color/hermit_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
