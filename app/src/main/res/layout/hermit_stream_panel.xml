<?xml version="1.0" encoding="utf-8"?>
<!-- Hermit: settings panel over the stream (com.junopark.hermit.hermit.StreamPanel). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hermitPanelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- Tapping outside the panel closes it -->
    <View
        android:id="@+id/hermitPanelScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true" />

    <LinearLayout
        android:id="@+id/hermitPanel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/hermit_panel_background"
        android:clickable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hermit_panel_title"
                    android:textColor="@color/hermit_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hermitPanelSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/hermit_text_helper"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/hermitPanelClose"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/hermit_panel_close"
                android:text="✕"
                android:textColor="@color/hermit_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hermit_layer2" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <!-- Picture and quality: applied by reconnecting -->
                <TextView style="@style/HermitPanelSection" android:text="@string/hermit_panel_section_picture" />
                <TextView style="@style/HermitPanelHelper" android:text="@string/hermit_panel_reconnect_note" />

                <TextView style="@style/HermitPanelLabel" android:text="@string/hermit_panel_resolution" />
                <Spinner
                    android:id="@+id/hermitPanelResolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <EditText
                    android:id="@+id/hermitPanelResolutionCustom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <TextView style="@style/HermitPanelLabel" android:text="@string/hermit_panel_fps" />
                <Spinner
                    android:id="@+id/hermitPanelFps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView style="@style/HermitPanelLabel" android:text="@string/hermit_panel_bitrate" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/hermitPanelBitrateSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <EditText
                        android:id="@+id/hermitPanelBitrateValue"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
                        android:inputType="numberDecimal"
                        android:selectAllOnFocus="true"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:text="Mbps"
                        android:textColor="@color/hermit_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/hermitPanelAutoBitrate"
                    style="@style/HermitPanelSwitch"
                    android:text="@string/hermit_panel_auto_bitrate" />
                <TextView android:id="@+id/hermitPanelBitrateHint" style="@style/HermitPanelHelper" />

                <TextView style="@style/HermitPanelLabel" android:text="@string/hermit_panel_codec" />
                <Spinner
                    android:id="@+id/hermitPanelCodec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Switch
                    android:id="@+id/hermitPanelHdr"
                    style="@style/HermitPanelSwitch"
                    android:text="@string/hermit_panel_hdr" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/hermitPanelApply"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/hermit_accent_fill"
                        android:text="@string/hermit_panel_apply"
                        android:textColor="@color/hermit_text_primary" />

                    <Button
                        android:id="@+id/hermitPanelRevert"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hermit_panel_revert"
                        android:textColor="@color/hermit_accent" />
                </LinearLayout>

                <View style="@style/HermitPanelDivider" />

                <!-- Display: applied at once -->
                <TextView style="@style/HermitPanelSection" android:text="@string/hermit_panel_section_display" />
                <TextView style="@style/HermitPanelHelper" android:text="@string/hermit_panel_live_note" />

                <Switch
                    android:id="@+id/hermitPanelOverlay"
                    style="@style/HermitPanelSwitch"
                    android:text="@string/hermit_panel_overlay" />

                <LinearLayout
                    android:id="@+id/hermitPanelMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp" />

                <TextView
                    android:id="@+id/hermitPanelOverlaySizeLabel"
                    style="@style/HermitPanelLabel"
                    android:text="@string/title_hermit_overlay_text_size" />
                <Spinner
                    android:id="@+id/hermitPanelOverlaySize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView style="@style/HermitPanelLabel" android:text="@string/hermit_quick_orientation" />
                <Spinner
                    android:id="@+id/hermitPanelOrientation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    style="@style/HermitPanelHelper"
                    android:text="@string/hermit_panel_orientation_hint" />

                <View style="@style/HermitPanelDivider" />

                <!-- Input: controls that do nothing in the current mode are dimmed -->
                <TextView style="@style/HermitPanelSection" android:text="@string/hermit_panel_section_input" />

                <Switch
                    android:id="@+id/hermitPanelTrackpad"
                    style="@style/HermitPanelSwitch"
                    android:text="@string/hermit_panel_trackpad" />

                <TextView android:id="@+id/hermitPanelTrackpadSpeedLabel" style="@style/HermitPanelLabel" />
                <SeekBar
                    android:id="@+id/hermitPanelTrackpadSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView android:id="@+id/hermitPanelScrollSpeedLabel" style="@style/HermitPanelLabel" />
                <SeekBar
                    android:id="@+id/hermitPanelScrollSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Switch
                    android:id="@+id/hermitPanelZoom"
                    style="@style/HermitPanelSwitch"
                    android:text="@string/title_checkbox_hermit_pinch_zoom" />

                <Switch
                    android:id="@+id/hermitPanelOsc"
                    style="@style/HermitPanelSwitch"
                    android:text="@string/hermit_panel_osc" />

                <Switch
                    android:id="@+id/hermitPanelKeypad"
                    style="@style/HermitPanelSwitch"
                    android:text="@string/hermit_panel_keypad" />

                <Button
                    android:id="@+id/hermitPanelKeypadEdit"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hermit_panel_keypad_edit"
                    android:textColor="@color/hermit_accent" />

                <Button
                    android:id="@+id/hermitPanelTextInput"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hermit_panel_text_input"
                    android:textColor="@color/hermit_accent" />

                <View style="@style/HermitPanelDivider" />

                <!-- Other -->
                <TextView style="@style/HermitPanelSection" android:text="@string/hermit_panel_section_other" />

                <Switch
                    android:id="@+id/hermitPanelClipboard"
                    style="@style/HermitPanelSwitch"
                    android:text="@string/title_checkbox_clipboard_sync" />

                <TextView style="@style/HermitPanelLabel" android:text="@string/title_hermit_panel_handle_side" />
                <Spinner
                    android:id="@+id/hermitPanelHandleSide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    style="@style/HermitPanelHelper"
                    android:text="@string/hermit_panel_handle_move_hint" />

                <View style="@style/HermitPanelDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/hermitPanelDisconnect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/hermit_panel_disconnect" />

                    <Button
                        android:id="@+id/hermitPanelQuitApp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/hermit_panel_quit_app"
                        android:textColor="@color/hermit_danger" />
                </LinearLayout>

                <TextView style="@style/HermitPanelHelper"
                    android:layout_marginTop="12dp"
                    android:text="@string/hermit_panel_back_hint" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
