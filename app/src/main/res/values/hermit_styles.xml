<?xml version="1.0" encoding="utf-8"?>
<!-- Hermit: styles of the stream panel. -->
<resources>
    <style name="HermitPanelSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/hermit_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="HermitPanelHelper">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/hermit_text_helper</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="HermitPanelLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/hermit_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="HermitPanelSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/hermit_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="HermitPanelDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@color/hermit_layer2</item>
    </style>
</resources>
