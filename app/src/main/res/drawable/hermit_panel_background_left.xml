<?xml version="1.0" encoding="utf-8"?>
<!-- Stream panel at the left edge: Carbon layer with a 1dp border on the side facing the stream
     (right). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hermit_border_strong" />
        </shape>
    </item>
    <item android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hermit_layer1" />
        </shape>
    </item>
</layer-list>
